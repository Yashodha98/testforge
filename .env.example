# Copy to .env and add your own key. Never commit .env.
# Option A - Anthropic Claude (key starts with sk-ant-): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional - Claude model
CLAUDE_MODEL=claude-opus-5-5
# Optional - low is faster and cheaper (good for live demos), medium is the default
CLAUDE_EFFORT=medium
# Option B - Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional - change if Google retires this model name
GEMINI_MODEL=gemini-2.5-flash
